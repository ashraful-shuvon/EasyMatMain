--- !u!114 &6106868669370275436
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2483999416694641750}
  m_Enabled: 1
  m_EditorHideFlags: 0
