--- !u!114 &1727544126093316474
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7007175265046582080}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.9339623, g: 0.9339623, b: 0.9339623, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 40
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 3
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "VISO Hunt is not just a game\u2014it\u2019s a weekly Augmented Reality
    (AR) adventure that brings the thrill of exploration into the real world. Every
    week, new virtual eggs are hidden across real-world locations, waiting for you
    to find them. Armed with your phone\u2019s GPS and camera, you\u2019ll set out
    on a journey where the digital and physical worlds collide. \n\nAs you step outside
    and open the app, the hunt begins. Look through your camera to scan your surroundings
    and uncover virtual eggs cleverly placed in parks, streets, cafes, landmarks,
    and unexpected corners of your city. Each egg you discover unlocks unique rewards\u2014from
    points and collectibles to exclusive in-game bonuses and special surprises. \n\nBut
    VISO Hunt is more than collecting eggs\u2014it\u2019s about competition and community.
    Join thousands of other players on the weekly hunt, climb the leaderboard, and
    challenge friends to see who can gather the most eggs. With every hunt, you\u2019ll
    sharpen your strategy, explore new places, and earn bragging rights along the
    way. VISO Hunt transforms everyday locations into an interactive playground,
    encouraging you to move, explore, and experience your world like never before.
    Whether you\u2019re a casual player seeking fun or a competitive hunter aiming
    for the top spot, there\u2019s always something new to discover."
